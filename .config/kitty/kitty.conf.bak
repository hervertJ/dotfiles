#font_family IosevkaTerm Nerd Font Mono
#font_family Fira Code
#font_family Monocraft
font_family Ia Writer Mono S
font_size 20
#font_family JetBrainsMono Nerd Font Mono
#font_size 16

disable_ligatures no
enable_audio_bell no

shell_integration disabled

cursor_shape block

remember_window_size no
inital_window_width 78c
inital_window_height 23c
window_padding_width 0
cursor_blink_interval 0

background_opacity 0.9
scrollbar_handle_opacity 0
scrollbar_track_opacity 0
scrollbar_track_hover_opacity 0
confirm_os_window_close 0

#repaint_delay 8
#input_delay 0
sync_to_monitor yes

cursor_trail 1

map page_up scroll_page_up
map page_down scroll_page_down

map ctrl+equal change_font_size all +4.0
map ctrl+plus change_font_size all +4.0
map ctrl+minus change_font_size all -4.0

map ctrl+shift+R change_font_size all 0

#map alt+k launch --type=overlay fish -lc "~/scripts/fzf-scripts.sh"
#map alt+k send_text all ~/scripts/fzf-scripts.sh\r
map alt+p send_text all ~/scripts/fzf-open-pdf.sh\r
map alt+t send_text all ~/scripts/fzf-typst.sh\r

# BEGIN_KITTY_THEME
# Base16-Black-Metal-Gorgoroth
include current-theme.conf
# END_KITTY_THEME
