layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
        children
    }

    tab name="nvim" split_direction="vertical" {
      pane
      pane
    }

    tab name="shell" split_direction="vertical" {
      pane
    }

    tab name="git" split_direction="vertical" {
      pane
    }
}
