layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }

    tab name="Nvim" split_direction="vertical" {
        pane
        pane split_direction="horizontal" {
            pane
            pane
            pane
        }
    }

    tab name="Shell" split_direction="vertical" {
      pane
    }
}
